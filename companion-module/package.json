{
	"name": "meyerproductions-karaoke",
	"version": "0.1.1",
	"description": "Companion-Modul für die Karaoke-Night-App: Show-Steuerung im Admin-Teil (Songwechsel, Standbild, Anmelde-/Voting-Sperre, Ansage-Text) über eine dedizierte Control-API.",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"author": {
		"name": "meyer.productions",
		"url": "https://meyer.productions"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meyer-productions/karaoke-night-signup.git",
		"directory": "companion-module"
	},
	"bugs": {
		"url": "https://github.com/meyer-productions/karaoke-night-signup/issues"
	},
	"homepage": "https://github.com/meyer-productions/karaoke-night-signup/tree/main/companion-module#readme",
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.0.1",
		"@types/node": "^22.19.17",
		"eslint": "^9.39.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"tsx": "^4.19.2",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.17.0"
}
