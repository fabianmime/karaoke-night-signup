# Kopieren nach .env und ausfüllen. .env ist per .htaccess gesperrt und nicht in Git.
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
# Bootstrap-Passwort fürs Admin-Panel - nach dem ersten Login dort ändern
ADMIN_PASSWORD=
# Bootstrap-Passwort der Statistik (/stats), danach dort änderbar
STATS_PASSWORD=
